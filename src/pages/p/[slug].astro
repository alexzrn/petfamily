---
import '../../styles/global.css';
import pets from '../../../data/pets/sample.json';

export function getStaticPaths() {
  return pets.map((p) => ({ params: { slug: p.slug }, props: { pet: p } }));
}

const { pet } = Astro.props;
const site = 'https://petfamily.beliberde.net';
const pageUrl = site + '/p/' + pet.slug;
const speciesLabels = { dog: 'Собака', cat: 'Кошка', other: 'Другое' };
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pet.name} — профиль питомца | Моя стая</title>
    <meta name="description" content={'Публичный профиль питомца ' + pet.name + '. Связь с владельцем без раскрытия личных данных.'} />
    <link rel="canonical" href={pageUrl} />
    <style>
      .pet-card { max-width: 560px; margin: 18px auto 0; border: 1px solid var(--line); border-radius: 14px; padding: 20px; background: #fff; }
      .pet-photo { width: 96px; height: 96px; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: 700; color: var(--muted); }
      .pet-name { display: flex; align-items: center; gap: 8px; font-size: 24px; margin: 12px 0 4px; }
      .badge { font-size: 13px; font-weight: 700; color: #1d6b2f; background: #e3f4e5; border-radius: 999px; padding: 3px 10px; }
      .pet-meta { color: var(--muted); font-size: 15px; margin: 2px 0; }
      .qr-box { margin-top: 18px; text-align: center; }
      #qr { display: inline-block; margin: 10px auto; min-height: 128px; }
      #qr img, #qr canvas { display: block; margin: 0 auto; }
      .tag-sample { margin-top: 18px; border: 1px dashed var(--line); border-radius: 12px; padding: 16px; text-align: center; color: var(--muted); }
      .tag-sample .tag { display: inline-block; border: 2px solid var(--accent); border-radius: 50%; width: 120px; height: 120px; line-height: 1.2; padding-top: 30px; box-sizing: border-box; color: var(--text); font-size: 14px; }
      .form-box label { display: block; font-size: 14px; margin: 10px 0 4px; }
      .form-box input, .form-box textarea { width: 100%; min-height: 44px; font-size: 16px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; box-sizing: border-box; }
      .form-box textarea { min-height: 88px; resize: vertical; }
      .field__error { color: #b3261e; font-size: 13px; min-height: 18px; margin: 2px 0 0; }
      .btn { min-height: 44px; }
    </style>
  </head>

  <body>
    <header class="site-head">
      <div class="wrap site-head__inner">
        <a class="brand" href="/">Моя стая</a>
        <a class="head-link" href="/">На главную</a>
      </div>
    </header>

    <main class="wrap">
      <div class="pet-card">
        <div class="pet-photo" aria-hidden="true">{pet.name.charAt(0)}</div>
        <h1 class="pet-name">{pet.name} {pet.verified && <span class="badge">проверен</span>}</h1>
        <p class="pet-meta">{speciesLabels[pet.species] || pet.species} · {pet.breed} · {pet.age}</p>
        <p class="pet-meta">Тестовый профиль для вёрстки.</p>

        <div class="qr-box">
          <h2>QR-код профиля</h2>
          <p class="pet-meta">Наведите камеру, откроется эта страница: {pageUrl}</p>
          <div id="qr" role="img" aria-label="QR-код страницы профиля"></div>
        </div>

        <div class="tag-sample" aria-label="Пример адресника">
          <h2>Пример адресника</h2>
          <div class="tag">{pet.name}<br />{pageUrl.replace('https://', '')}</div>
          <p>Круглый жетон на ошейник: имя и адрес страницы. Телефон на жетоне не печатаем.</p>
        </div>

        <section aria-label="Связаться с владельцем">
          <h2>Связаться с владельцем</h2>
          <p class="pet-meta">Телефон скрыт. Сообщение уйдёт владельцу, ваш контакт увидит только он.</p>
          <form class="form-box" id="contact-form" novalidate>
            <label for="cf-contact">Ваш контакт для ответа</label>
            <input id="cf-contact" type="text" placeholder="Телефон или почта" required />
            <p class="field__error" data-error="contact"></p>
            <label for="cf-text">Сообщение (от 10 символов)</label>
            <textarea id="cf-text" required></textarea>
            <p class="field__error" data-error="text"></p>
            <button class="btn" type="submit" style="margin-top:12px;">Отправить владельцу</button>
          </form>
          <div id="contact-success" hidden tabindex="-1" role="status">
            <h3>Сообщение принято локально.</h3>
            <p>Отправки на сервер на этом этапе нет, данные никуда не ушли.</p>
          </div>
        </section>
      </div>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>Личные данные владельца не публикуются.</p>
        <p class="site-foot__legal">© {year} Моя стая</p>
      </div>
    </footer>

    <script is:inline define:vars={{ pageUrl: pageUrl }}>
      window.__PAGE_URL__ = pageUrl;
    </script>
    <script is:inline>
      (() => {
        function draw() {
          if (!window.QRCode) return;
          new window.QRCode(document.getElementById('qr'), {
            text: window.__PAGE_URL__,
            width: 160,
            height: 160,
            correctLevel: window.QRCode.CorrectLevel.M,
          });
        }
        if (window.QRCode) { draw(); return; }
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js';
        s.onload = draw;
        document.head.appendChild(s);

        const form = document.getElementById('contact-form');
        const success = document.getElementById('contact-success');
        function setError(name, msg) {
          const n = form.querySelector('[data-error="' + name + '"]');
          if (n) n.textContent = msg || '';
        }
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const contact = document.getElementById('cf-contact').value.trim();
          const text = document.getElementById('cf-text').value.trim();
          const contactOk = /^[+0-9][0-9 ()-]{5,}$/.test(contact) || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(contact);
          setError('contact', contactOk ? '' : 'Укажите телефон или почту');
          setError('text', text.length >= 10 ? '' : 'Сообщение от 10 символов');
          if (!contactOk || text.length < 10) return;
          form.hidden = true;
          success.hidden = false;
          success.focus();
        });
      })();
    </script>
  </body>
</html>
