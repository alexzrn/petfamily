---
import '../styles/global.css';
import spots from '../../data/lost/sample.json';

const site = 'https://petfamily.beliberde.net';
const year = new Date().getFullYear();
const districts = [...new Set(spots.map((s) => s.district).filter(Boolean))].sort();
const animalLabels = { dog: 'Собака', cat: 'Кошка', other: 'Другое' };
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Доска потеряшек Москвы | Моя стая</title>
    <meta name="description" content="Поиск и находки домашних животных в Москве: фильтры по округу и виду животного, форма сообщения о находке." />
    <link rel="canonical" href={site + '/lost'} />
    <style>
      .lost-page { padding-bottom: 40px; }
      .filters { display: flex; flex-direction: column; gap: 10px; margin: 18px 0; }
      .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
      .chip { min-height: 44px; padding: 10px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font-size: 15px; cursor: pointer; }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      .filter-line { display: flex; gap: 8px; flex-wrap: wrap; }
      .filter-line select { min-height: 44px; font-size: 16px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; max-width: 100%; }
      .result-count { color: var(--muted); font-size: 14px; }
      .spot-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
      .spot-list li { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: #fff; }
      .spot-list h3 { margin: 0 0 4px; font-size: 16px; }
      .spot-list .kind { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px; margin-bottom: 6px; }
      .spot-list .kind.lost { background: #fde8e8; color: #a33; }
      .spot-list .kind.found { background: #e3f4e5; color: #1d6b2f; }
      .spot-list p { margin: 2px 0; font-size: 14px; color: var(--muted); }
      .rules { margin-top: 26px; border: 1px solid var(--line); border-radius: 12px; padding: 18px; background: var(--surface); }
      .rules h2 { margin-top: 0; font-size: 18px; }
      .rules li { margin: 6px 0; font-size: 15px; }
      .form-box label { display: block; font-size: 14px; margin: 10px 0 4px; }
      .form-box input, .form-box select, .form-box textarea { width: 100%; min-height: 44px; font-size: 16px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; box-sizing: border-box; }
      .form-box textarea { min-height: 88px; resize: vertical; }
      .field__error { color: #b3261e; font-size: 13px; min-height: 18px; margin: 2px 0 0; }
    </style>
  </head>

  <body>
    <header class="site-head">
      <div class="wrap site-head__inner">
        <a class="brand" href="/">Моя стая</a>
        <a class="head-link" href="/">На главную</a>
      </div>
    </header>

    <main class="wrap lost-page">
      <h1>Доска потеряшек</h1>
      <p>Поиск и находки домашних животных в Москве. Объявления ниже тестовые, для проверки вёрстки.</p>

      <div class="filters" role="search" aria-label="Фильтры объявлений">
        <div class="chip-row" id="kind-row">
          <button class="chip" data-kind="" aria-pressed="true">Все</button>
          <button class="chip" data-kind="lost" aria-pressed="false">Поиск</button>
          <button class="chip" data-kind="found" aria-pressed="false">Находки</button>
        </div>
        <div class="chip-row" id="animal-row">
          <button class="chip" data-animal="" aria-pressed="true">Любое животное</button>
          <button class="chip" data-animal="dog" aria-pressed="false">Собаки</button>
          <button class="chip" data-animal="cat" aria-pressed="false">Кошки</button>
          <button class="chip" data-animal="other" aria-pressed="false">Другие</button>
        </div>
        <div class="filter-line">
          <select id="f-district" aria-label="Округ">
            <option value="">Все округа</option>
            {districts.map((d) => <option value={d}>{d}</option>)}
          </select>
        </div>
      </div>

      <p class="result-count" id="result-count" role="status"></p>
      <ul class="spot-list" id="spot-list"></ul>

      <section class="rules" aria-label="Правила публикации">
        <h2>Правила публикации</h2>
        <ul>
          <li>Не публикуйте точные адреса жилых домов: достаточно округа и общественного места рядом.</li>
          <li>Не выкладывайте чужие данные без согласия владельца: телефон и имя только свои или с разрешения.</li>
        </ul>
      </section>

      <section aria-label="Сообщить о находке">
        <h2>Сообщить о находке</h2>
        <form class="form-box" id="found-form" novalidate>
          <label for="ff-animal">Животное</label>
          <select id="ff-animal" required>
            <option value="">Выберите</option>
            <option value="dog">Собака</option>
            <option value="cat">Кошка</option>
            <option value="other">Другое</option>
          </select>
          <p class="field__error" data-error="animal"></p>
          <label for="ff-district">Округ</label>
          <select id="ff-district" required>
            <option value="">Выберите</option>
            {districts.map((d) => <option value={d}>{d}</option>)}
          </select>
          <p class="field__error" data-error="district"></p>
          <label for="ff-contact">Контакт для связи</label>
          <input id="ff-contact" type="text" placeholder="Телефон или почта" required />
          <p class="field__error" data-error="contact"></p>
          <label for="ff-desc">Описание (от 20 символов, без точного адреса дома)</label>
          <textarea id="ff-desc" required></textarea>
          <p class="field__error" data-error="desc"></p>
          <label><input id="ff-consent" type="checkbox" required /> Данные мои или есть согласие владельца на публикацию.</label>
          <p class="field__error" data-error="consent"></p>
          <button class="btn" type="submit" style="min-height:44px;margin-top:12px;">Отправить</button>
        </form>
        <div id="found-success" hidden tabindex="-1" role="status">
          <h3>Заявка принята локально.</h3>
          <p>Отправки на сервер на этом этапе нет, данные никуда не ушли. Модерация и публикация появятся позже.</p>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>Тестовые объявления. Реальные данные появятся после запуска модерации.</p>
        <p class="site-foot__legal">© {year} Моя стая</p>
      </div>
    </footer>

    <script is:inline define:vars={{ itemsData: spots }}>
      window.__LOST__ = itemsData;
    </script>
    <script is:inline>
      (() => {
        const all = window.__LOST__ || [];
        const state = { kind: '', animal: '', district: '' };
        const animalLabels = { dog: 'Собака', cat: 'Кошка', other: 'Другое' };
        const list = document.getElementById('spot-list');
        const count = document.getElementById('result-count');
        function esc(s) {
          return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        function render() {
          const items = all.filter((s) =>
            (!state.kind || s.kind === state.kind) &&
            (!state.animal || s.animal === state.animal) &&
            (!state.district || s.district === state.district));
          count.textContent = 'Показано объявлений: ' + items.length + ' из ' + all.length;
          list.innerHTML = items.map((s) =>
            '<li><span class="kind ' + s.kind + '">' + (s.kind === 'lost' ? 'Поиск' : 'Находка') + '</span>' +
            '<h3>' + esc(s.name || (animalLabels[s.animal] + ', имя неизвестно')) + '</h3>' +
            '<p>' + esc(animalLabels[s.animal] || s.animal) + ' · ' + esc(s.district) + ' · ' + esc(s.place) + ' · ' + esc(s.date) + '</p>' +
            '<p>' + esc(s.description) + '</p>' +
            '<p>Контакт: ' + esc(s.contact) + '</p></li>').join('');
        }
        function chips(id, key) {
          document.getElementById(id).addEventListener('click', (e) => {
            const b = e.target.closest('button');
            if (!b) return;
            state[key] = b.dataset[key];
            document.querySelectorAll('#' + id + ' .chip').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
            render();
          });
        }
        chips('kind-row', 'kind');
        chips('animal-row', 'animal');
        document.getElementById('f-district').addEventListener('change', (e) => { state.district = e.target.value; render(); });
        render();

        const form = document.getElementById('found-form');
        const success = document.getElementById('found-success');
        function setError(name, msg) {
          const n = form.querySelector('[data-error="' + name + '"]');
          if (n) n.textContent = msg || '';
        }
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const animal = document.getElementById('ff-animal').value;
          const district = document.getElementById('ff-district').value;
          const contact = document.getElementById('ff-contact').value.trim();
          const desc = document.getElementById('ff-desc').value.trim();
          const consent = document.getElementById('ff-consent').checked;
          const contactOk = /^[+0-9][0-9 ()-]{5,}$/.test(contact) || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(contact);
          setError('animal', animal ? '' : 'Выберите животное');
          setError('district', district ? '' : 'Выберите округ');
          setError('contact', contactOk ? '' : 'Укажите телефон или почту');
          setError('desc', desc.length >= 20 ? '' : 'Опишите подробнее, минимум 20 символов');
          setError('consent', consent ? '' : 'Подтвердите согласие на публикацию');
          if (!animal || !district || !contactOk || desc.length < 20 || !consent) return;
          form.hidden = true;
          success.hidden = false;
          success.focus();
        });
      })();
    </script>
  </body>
</html>
